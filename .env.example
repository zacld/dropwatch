# Dropwatch Monitor configuration. Copy to .env and edit. Never commit real keys.
# Nothing here is needed for `npm test` or `npm run monitor:demo`.

# --- server ---
DROPWATCH_MONITOR_PORT=4200
# DROPWATCH_MONITOR_DATA=./data/monitor
DROPWATCH_LOG_LEVEL=info
# Fixture replay routes (/api/dev/*). Leave off outside local development.
DROPWATCH_DEV_ROUTES=off

# --- data quality and alerting ---
# A confirmed field older than this is shown as stale.
DROPWATCH_STALE_AFTER_HOURS=24
# An observation older than this when it arrives is stored as history but never alerts.
DROPWATCH_MAX_OBSERVATION_AGE_HOURS=6
DROPWATCH_MIN_ALERT_CONFIDENCE=0.7
DROPWATCH_ALERT_DEDUPE_HOURS=24

# --- retrieval (live retrieval is OFF for every source by default) ---
DROPWATCH_REQUEST_TIMEOUT_MS=15000
DROPWATCH_MAX_RESPONSE_BYTES=5000000
# Identify yourself honestly if you enable live retrieval.
DROPWATCH_CONTACT=you@example.com
# Scheduled polling of configured targets. Requires live retrieval for that source too.
DROPWATCH_SCHEDULER=off
DROPWATCH_SCHEDULER_TICK_SECONDS=60

# --- signal priority: which due watch gets a site's next check (off by default; never adds requests or alerts) ---
DROPWATCH_SIGNAL_PRIORITY=off
# A tier that sold out within this many hours makes its event a priority (the next wave often follows).
DROPWATCH_SIGNAL_SOLD_OUT_FOLLOWUP_HOURS=6
# A falling count is a priority when it projects to sell out within this many hours, or is at/below LOW_STOCK.
DROPWATCH_SIGNAL_PROJECT_HOURS=6
DROPWATCH_SIGNAL_LOW_STOCK=25
DROPWATCH_SIGNAL_RELEASE_SOON_HOURS=3
DROPWATCH_SIGNAL_EVENT_SOON_HOURS=72
# No ticket change for this many days: checked after everything else that is due.
DROPWATCH_SIGNAL_QUIET_DAYS=3
# A watch this many intervals overdue is checked next regardless of signals (no watch starves).
DROPWATCH_SIGNAL_MAX_OVERDUE_INTERVALS=3

# --- bursts: a few extra checks after a trigger (off by default; never alert by themselves) ---
# Internal triggers: a main tier just sold out, or a remaining count projected to sell out within BURST_FALLING_HOURS.
# External triggers: POST /api/triggers or `cli.js trigger` (e.g. a platform email), starting with an immediate check.
# All extra checks (bursts and release windows) share DROPWATCH_RELEASE_MAX_EXTRA_PER_HOUR per site.
DROPWATCH_SIGNAL_BURSTS=off
DROPWATCH_BURST_OFFSETS_MINUTES=2,5,15
DROPWATCH_TRIGGER_OFFSETS_MINUTES=0,2,5,15
# Checks per trigger (max 8).
DROPWATCH_BURST_MAX_CHECKS=4
DROPWATCH_BURST_FALLING_HOURS=2

# --- per-source kill switches (on/off). Off disables the connector entirely, including fixture ingest. ---
DROPWATCH_SOURCE_SKIDDLE=on
DROPWATCH_SOURCE_FATSOMA=on
DROPWATCH_SOURCE_DICE=on
DROPWATCH_SOURCE_TICKETMASTER=on
DROPWATCH_SOURCE_RESIDENT_ADVISOR=on

# --- per-source live retrieval (on/off). Only enable after the source's access method and terms are assessed. ---
# Resident Advisor live retrieval is refused in code regardless of this setting.
DROPWATCH_LIVE_SKIDDLE=off
DROPWATCH_LIVE_FATSOMA=off
DROPWATCH_LIVE_DICE=off
DROPWATCH_LIVE_TICKETMASTER=off

# Polling interval per source in minutes. Floors: 60 for public pages, 30 for official APIs.
# DROPWATCH_INTERVAL_TICKETMASTER_MINUTES=360
# Never two requests to the same site closer than this (floor 30).
DROPWATCH_MIN_REQUEST_GAP_SECONDS=60

# --- release windows: extra checks around a KNOWN release time of a watched event (off by default) ---
# Normal monitoring is unchanged. Extras run only for events whose stored data has a release time, never while
# the site is backing off or paused, and slots missed by more than the tolerance are logged, not fired late.
DROPWATCH_RELEASE_WINDOW=off
# Minutes relative to the release (max 8 values, each -60..120).
DROPWATCH_RELEASE_OFFSETS_MINUTES=-2,1,5,15
# Fatsoma defaults to -2,2,5,15 (its pages may be cached ~2 min). Per-site override, which beats the line above:
# DROPWATCH_RELEASE_OFFSETS_FATSOMA_MINUTES=-2,2,5,15
# The per-hour figure is shared by ALL extra checks: release windows and bursts together.
# Extra checks per release per event (max 8), and per site in any rolling hour (max 8; on top of the normal 1).
DROPWATCH_RELEASE_MAX_CHECKS=4
DROPWATCH_RELEASE_MAX_EXTRA_PER_HOUR=4
# A slot not run within this many minutes of its time is logged as missed (1..15).
DROPWATCH_RELEASE_SLOT_TOLERANCE_MINUTES=3

# --- credentials ---
# Ticketmaster Discovery API key (developer.ticketmaster.com). Optional.
TICKETMASTER_API_KEY=
