# Dropwatch Monitor configuration. Copy to .env and edit. Never commit real keys.
# Nothing here is needed for `npm test` or `npm run monitor:demo`.

# --- server ---
DROPWATCH_MONITOR_PORT=4200
# DROPWATCH_MONITOR_DATA=./data/monitor
DROPWATCH_LOG_LEVEL=info
# Fixture replay routes (/api/dev/*). Leave off outside local development.
DROPWATCH_DEV_ROUTES=off

# --- data quality and alerting ---
# A confirmed field older than this is shown as stale.
DROPWATCH_STALE_AFTER_HOURS=24
# An observation older than this when it arrives is stored as history but never alerts.
DROPWATCH_MAX_OBSERVATION_AGE_HOURS=6
DROPWATCH_MIN_ALERT_CONFIDENCE=0.7
DROPWATCH_ALERT_DEDUPE_HOURS=24

# --- retrieval (live retrieval is OFF for every source by default) ---
DROPWATCH_REQUEST_TIMEOUT_MS=15000
DROPWATCH_MAX_RESPONSE_BYTES=5000000
# Identify yourself honestly if you enable live retrieval.
DROPWATCH_CONTACT=you@example.com
# Scheduled polling of configured targets. Requires live retrieval for that source too.
DROPWATCH_SCHEDULER=off
DROPWATCH_SCHEDULER_TICK_SECONDS=60

# --- per-source kill switches (on/off). Off disables the connector entirely, including fixture ingest. ---
DROPWATCH_SOURCE_SKIDDLE=on
DROPWATCH_SOURCE_FATSOMA=on
DROPWATCH_SOURCE_DICE=on
DROPWATCH_SOURCE_TICKETMASTER=on
DROPWATCH_SOURCE_RESIDENT_ADVISOR=on

# --- per-source live retrieval (on/off). Only enable after the source's access method and terms are assessed. ---
# Resident Advisor live retrieval is refused in code regardless of this setting.
DROPWATCH_LIVE_SKIDDLE=off
DROPWATCH_LIVE_FATSOMA=off
DROPWATCH_LIVE_DICE=off
DROPWATCH_LIVE_TICKETMASTER=off

# Polling interval per source in minutes. Floors: 60 for public pages, 30 for official APIs.
# DROPWATCH_INTERVAL_TICKETMASTER_MINUTES=360

# --- credentials ---
# Ticketmaster Discovery API key (developer.ticketmaster.com). Optional.
TICKETMASTER_API_KEY=
